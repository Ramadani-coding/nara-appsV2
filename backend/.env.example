PORT=5001
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL Connection Pooler recommended)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.eakaptprmmpabiufgtwc.supabase.co:5432/postgres

# Supabase Auth & Storage API
SUPABASE_URL=https://eakaptprmmpabiufgtwc.supabase.co
SUPABASE_ANON_KEY=

# Premiumku Supplier API
PREMIUMKU_BASE_URL=https://premku.com/api
PREMIUMKU_API_KEY=
PREMKU_SYNC_INTERVAL_MINUTES=5

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Fonnte WhatsApp Notification Gateway (Optional tapi direkomendasikan)
FONNTE_TOKEN=

# Cryptographic Salt for Order Verification Tokens (Gunakan random string panjang di production)
ORDER_SECRET_SALT=ganti-dengan-random-string-kriptografis-rahasia-32-karakter

# Frontend Client URL (Domain Website Anda di production, misal: https://narastore.id)
FRONTEND_URL=http://localhost:5173
