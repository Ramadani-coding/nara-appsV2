# ===================================================
# Git Ignore Configuration for Nara Store
# ===================================================

# ---------------------------------------------------
# 1. Environment Variables & Rahasia Kredensial (CRITICAL)
# Mencegah bocornya database URL, Midtrans key, API keys
# ---------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# Pengecualian: Pastikan template contoh (.env.example) tetap ter-upload
!.env.example
!backend/.env.example
!frontend/.env.example

# ---------------------------------------------------
# 2. Dependencies (Node.js)
# ---------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# ---------------------------------------------------
# 3. Output Build & Kompilasi
# ---------------------------------------------------
dist/
dist-ssr/
build/
backend/dist/
frontend/dist/

# ---------------------------------------------------
# 4. Logs & Debugging
# ---------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------
# 5. Editor & OS Files
# ---------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------
# 6. Temporary & Cache Files
# ---------------------------------------------------
.eslintcache
.stylelintcache
.cache/
tmp/
temp/
scratch/
