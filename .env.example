# ===================================================
# Nara Store Root Environment Variables (Docker Compose)
# ===================================================

# Port yang dibuka di VPS untuk akses website (Default: 80)
# Jika menggunakan Nginx Proxy Manager / reverse proxy lain di host, ubah misalnya ke 8080 atau 3000
APP_PORT=80

# URL API yang digunakan oleh Frontend saat build (Default: /api)
# Jangan ubah jika menggunakan reverse proxy terintegrasi Nginx di frontend
VITE_API_URL=/api

# Kredensial Supabase (Opsional jika ingin override default frontend)
VITE_SUPABASE_URL=https://eakaptprmmpabiufgtwc.supabase.co
VITE_SUPABASE_ANON_KEY=

# Konfigurasi Database Lokal (Hanya digunakan jika menjalankan profil --profile db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_db_yang_kuat
POSTGRES_DB=nara_digital
